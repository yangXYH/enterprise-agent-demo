# LLM 配置（DeepSeek 示例）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=8192
LLM_MODEL=deepseek-chat

# 聚水潭开放平台配置（正式值只放服务器 .env，不要提交到代码）
JUSHUITAN_ENDPOINT=https://openapi.jushuitan.com
JUSHUITAN_APP_KEY=your_jushuitan_app_key
JUSHUITAN_APP_SECRET=your_jushuitan_app_secret
JUSHUITAN_ACCESS_TOKEN=your_jushuitan_access_token
JUSHUITAN_REFRESH_TOKEN=your_jushuitan_refresh_token
# 可选：如果自动识别不到“花东仓”，在这里填聚水潭 /open/wms/partner/query 返回的花东仓 wms_co_id
JUSHUITAN_HUADONG_WMS_CO_ID=
# 花东库存自动同步：页面可覆盖，环境变量只作为首次建表默认值
JUSHUITAN_SYNC_ENABLED=false
JUSHUITAN_SYNC_INTERVAL_MINUTES=10
JUSHUITAN_SYNC_RECALCULATE=true
JUSHUITAN_QUERY_BATCH_SIZE=2
JUSHUITAN_QUERY_SLEEP_SECONDS=0.35
JUSHUITAN_QUERY_MAX_WORKERS=2
JUSHUITAN_QUERY_START_GAP_SECONDS=0.8
JUSHUITAN_QUERY_MAX_RETRIES=3
JUSHUITAN_QUERY_RETRY_BASE_SECONDS=1.0

# 图片生成 API（OpenAI Images 兼容中转）
DALLE_API_KEY=your_dalle_api_key_here
DALLE_BASE_URL=https://api.example.invalid/v1
# 经营数据分析专用 AI（服务端配置，禁止使用 VITE_ 前缀）
OPERATING_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
OPERATING_AI_MODEL=deepseek-v4-flash
OPERATING_AI_KEY=
# 同时调用模型的问答数。单接入点默认串行，避免拥塞导致超时
OPERATING_AI_CONCURRENCY=1
# 单次模型调用最长等待秒数；超时后使用已查询到的真实数据生成保底答案
OPERATING_AI_TIMEOUT_SECONDS=60
# 查询规划最长等待秒数；超时后优先承接上一轮查询条件，用本地规则继续分析
OPERATING_AI_PLANNER_TIMEOUT_SECONDS=30
# 默认关闭额外的一轮模型复核以缩短回答时间；本地事实和引用校验仍会执行
OPERATING_AI_REVIEW_ENABLED=0
# 店铺报表 AI 问答：默认复用上方 OPERATING_AI_*（同一接入点），可按需单独覆盖
SHOP_REPORT_AI_MODEL=deepseek-v4-flash
# 写作器单次调用最长等待秒数；ARK 首字延迟可能超过 60 秒，超时后改用保底数据草稿
SHOP_REPORT_AI_TIMEOUT_SECONDS=120
SHOP_REPORT_AI_REVIEW_ENABLED=0
# 经营分析数据与其他业务模块共用上方 DB_URL / DB_* 指向的 MySQL；不再使用本地 SQLite 文件
# 数据库按环境配置：测试启动脚本使用 APP_ENV=test，服务器启动脚本使用 APP_ENV=production。
# 具体配置请分别放在 .env.test / .env.production，不要把真实密码提交到代码仓库。
# 可选：附加经营知识目录；内置知识及运营/产品知识上传目录会自动建立版本索引
# OPERATING_KNOWLEDGE_DIR=
