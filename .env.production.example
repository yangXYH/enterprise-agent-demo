# 正式环境配置模板：复制为服务器上的 .env.production，再填写所有密钥
APP_ENV=production

# 正式数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enterprise_agent_db
DB_USER=enterprise_agent
DB_PASSWORD=<服务器数据库密码>

# 经营分析 AI
OPERATING_AI_KEY=<ARK_API_KEY>
OPERATING_AI_MODEL=deepseek-v4-flash
OPERATING_AI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
OPERATING_AI_CONCURRENCY=1
OPERATING_AI_TIMEOUT_SECONDS=60
OPERATING_AI_PLANNER_TIMEOUT_SECONDS=30
OPERATING_AI_REVIEW_ENABLED=0

# 通用 AI：与经营分析使用同一个可用的方舟账号和模型
LLM_API_KEY=<ARK_API_KEY>
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=8192
LLM_MODEL=deepseek-v4-flash

# 聚水潭
JUSHUITAN_ENDPOINT=https://openapi.jushuitan.com
JUSHUITAN_APP_KEY=<JUSHUITAN_APP_KEY>
JUSHUITAN_APP_SECRET=<JUSHUITAN_APP_SECRET>
JUSHUITAN_ACCESS_TOKEN=<JUSHUITAN_ACCESS_TOKEN>
JUSHUITAN_REFRESH_TOKEN=<JUSHUITAN_REFRESH_TOKEN>
JUSHUITAN_HUADONG_WMS_CO_ID=
JUSHUITAN_SYNC_ENABLED=false
JUSHUITAN_SYNC_INTERVAL_MINUTES=10
JUSHUITAN_SYNC_RECALCULATE=false
JUSHUITAN_QUERY_MAX_WORKERS=2
JUSHUITAN_QUERY_START_GAP_SECONDS=0.8
JUSHUITAN_QUERY_MAX_RETRIES=3
JUSHUITAN_QUERY_RETRY_BASE_SECONDS=1.0
JUSHUITAN_QUERY_BATCH_SIZE=2
JUSHUITAN_QUERY_SLEEP_SECONDS=0.35
